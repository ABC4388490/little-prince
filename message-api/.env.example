# 复制为 .env 后填写真实值

# 启用跨设备记忆（Postgres）
DATABASE_URL=postgresql://username:password@host:5432/dbname

# 允许前端来源（逗号分隔）。与页面 origin 完全一致（含端口），否则浏览器报 CORS。
# 示例含 Live Server(5500) 与 http.server 常用端口；线上追加 https://你的域名
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:8888,http://localhost:8888,http://127.0.0.1:9999,http://localhost:9999

# 可选：更自然回复
# DEEPSEEK_API_KEY=sk-xxxx
